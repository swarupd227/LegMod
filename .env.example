# Copy to .env and fill in values
# Anthropic API key (required for AI agents)
ANTHROPIC_API_KEY=sk-ant-replace-me

# LLM model routing
LLM_MODEL_OPUS=claude-opus-4-7
LLM_MODEL_SONNET=claude-sonnet-4-6
LLM_DEFAULT_MODEL=sonnet

# Postgres
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas_dev_pwd
POSTGRES_DB=atlas

# Neo4j
NEO4J_AUTH=neo4j/atlas_dev_pwd

# MinIO (S3-compatible)
MINIO_ROOT_USER=atlas
MINIO_ROOT_PASSWORD=atlas_dev_pwd
MINIO_BUCKET_CORPUS=atlas-corpus
MINIO_BUCKET_ARTIFACTS=atlas-artifacts

# Redis
REDIS_PASSWORD=atlas_dev_pwd

# Temporal
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

# Stub auth
DEV_USER_EMAIL=dev@envestnet.local
DEV_USER_NAME=Dev User

# Service ports (host).
# Atlas claims the 28xxx range so it coexists with NHEP (1xxxx) and other
# local stacks. App-facing ports keep memorable numbers; everything else is
# in 28xxx. Bump any of these if you have further collisions.
PORT_FRONTEND=3000
PORT_GATEWAY=8080
PORT_PRJ=8081
PORT_LLM=8082
PORT_ARCH=8083
PORT_GRAPH=8084
PORT_CAP=8085
PORT_RECON=8086
PORT_GEN=8087
PORT_TEMPORAL_UI=8088
PORT_DIFF=8089
PORT_REPORTS=8090
PORT_PROV=8091
PORT_UPLIFT=8092

PORT_NEO4J_HTTP=28474
PORT_MINIO_CONSOLE=28001
PORT_POSTGRES=28432
PORT_REDIS=28379
PORT_NEO4J_BOLT=28687
PORT_MINIO_S3=28900
PORT_TEMPORAL=28233
